{
  "attribute": "minecraft:generic.movement_speed",
  "blight_scaling": {
    "boss_mobs": "$scaling_attributes.movement_speed.blight_scaling.boss",
    "hostile_mobs": "$scaling_attributes.movement_speed.blight_scaling.hostile",
    "peaceful_mobs": "$scaling_attributes.movement_speed.blight_scaling.peaceful"
  },
  "mob_scaling": {
    "boss_mobs": "$scaling_attributes.movement_speed.mob_scaling.boss",
    "hostile_mobs": "$scaling_attributes.movement_speed.mob_scaling.hostile",
    "peaceful_mobs": "$scaling_attributes.movement_speed.mob_scaling.peaceful"
  },
  "player_bonus_settings": {
    "max_value": 2.0,
    "min_value": 0.01,
    "starting_value": 0.1
  },
  "player_mutators": {
    "on_player_death": "$scaling_attributes.movement_speed.mutator.player_dies",
    "on_player_kill_boss": "$scaling_attributes.movement_speed.mutator.player_kills_boss",
    "on_player_kill_mob": "$scaling_attributes.movement_speed.mutator.player_kills_mob",
    "on_player_sleep": "$scaling_attributes.movement_speed.mutator.player_sleeps"
  }
}